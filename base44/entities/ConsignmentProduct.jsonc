{
  "name": "ConsignmentProduct",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "owner_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0442\u043e\u0432\u0430\u0440\u0430"
    },
    "owner_email": {
      "type": "string",
      "description": "Email \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0442\u043e\u0432\u0430\u0440\u0430 (\u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435)"
    },
    "seller_email": {
      "type": "string",
      "description": "Email \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "seller_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "brand": {
      "type": "string",
      "description": "\u0411\u0440\u0435\u043d\u0434"
    },
    "model": {
      "type": "string",
      "description": "\u041c\u043e\u0434\u0435\u043b\u044c"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "\u0422\u0443\u0444\u043b\u0438",
        "\u0421\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u0430\u044f \u043e\u0431\u0443\u0432\u044c",
        "\u0421\u0430\u043f\u043e\u0433\u0438",
        "\u0414\u0440\u0443\u0433\u043e\u0435"
      ],
      "default": "\u0422\u0443\u0444\u043b\u0438",
      "description": "\u0422\u0438\u043f \u0442\u043e\u0432\u0430\u0440\u0430"
    },
    "color": {
      "type": "string",
      "default": "\u0427\u0451\u0440\u043d\u044b\u0439",
      "description": "\u0426\u0432\u0435\u0442"
    },
    "size_from": {
      "type": "number",
      "default": 39,
      "description": "\u0420\u0430\u0437\u043c\u0435\u0440 \u043e\u0442"
    },
    "size_to": {
      "type": "number",
      "default": 44,
      "description": "\u0420\u0430\u0437\u043c\u0435\u0440 \u0434\u043e"
    },
    "pairs_per_box": {
      "type": "number",
      "default": 6,
      "description": "\u041f\u0430\u0440 \u0432 \u043a\u043e\u0440\u043e\u0431\u043a\u0435"
    },
    "photo_url": {
      "type": "string",
      "description": "\u0424\u043e\u0442\u043e \u0442\u043e\u0432\u0430\u0440\u0430"
    },
    "owner_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 (\u0437\u0430\u043a\u0443\u043f\u043e\u0447\u043d\u0430\u044f) \u0437\u0430 \u043a\u043e\u0440\u043e\u0431\u043a\u0443"
    },
    "sale_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0437\u0430 \u043a\u043e\u0440\u043e\u0431\u043a\u0443 (\u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0434\u0430\u0432\u0435\u0446)"
    },
    "boxes_in_stock": {
      "type": "number",
      "default": 0,
      "description": "\u041a\u043e\u0440\u043e\u0431\u043e\u043a \u043d\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0443 \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    }
  },
  "required": [
    "business_id",
    "owner_name",
    "brand",
    "model",
    "owner_price",
    "sale_price"
  ]
}