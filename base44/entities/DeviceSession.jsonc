{
  "name": "DeviceSession",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "user_email": {
      "type": "string",
      "description": "Email \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
    },
    "user_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "employee",
        "admin"
      ],
      "description": "\u0420\u043e\u043b\u044c"
    },
    "employee_id": {
      "type": "string",
      "description": "ID \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 (\u0435\u0441\u043b\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a)"
    },
    "device_info": {
      "type": "string",
      "description": "User-Agent \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0412\u0440\u0435\u043c\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438"
    },
    "session_token": {
      "type": "string",
      "description": "\u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u043e\u043a\u0435\u043d \u0441\u0435\u0441\u0441\u0438\u0438"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0410\u043a\u0442\u0438\u0432\u043d\u0430 \u043b\u0438 \u0441\u0435\u0441\u0441\u0438\u044f"
    }
  },
  "required": [
    "business_id",
    "user_email",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}