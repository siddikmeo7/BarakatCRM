{
  "name": "AccessGrant",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "user",
        "business"
      ],
      "description": "\u041a\u043e\u043c\u0443 \u0432\u044b\u0434\u0430\u043d \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f: user \u2014 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u043c\u0443 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044e (\u043f\u043e email), business \u2014 \u0446\u0435\u043b\u043e\u043c\u0443 \u0431\u0438\u0437\u043d\u0435\u0441\u0443"
    },
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430 (\u0434\u043b\u044f scope = business)"
    },
    "user_email": {
      "type": "string",
      "description": "Email \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043e\u0442\u043a\u0440\u044b\u0442 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f (\u0434\u043b\u044f scope = user)"
    },
    "user_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f (\u0434\u043b\u044f \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u0430 \u0441\u043f\u0438\u0441\u043a\u0430)"
    },
    "reason": {
      "type": "string",
      "description": "\u041f\u0440\u0438\u0447\u0438\u043d\u0430: \u043f\u043e\u0447\u0435\u043c\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0438\u043b\u0438 \u0431\u0438\u0437\u043d\u0435\u0441 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0431\u0435\u0437 \u043e\u043f\u043b\u0430\u0442\u044b"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u043e \u043a\u0430\u043a\u043e\u0439 \u0434\u0430\u0442\u044b \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f. \u041f\u0443\u0441\u0442\u043e \u2014 \u0431\u0435\u0441\u0441\u0440\u043e\u0447\u043d\u043e"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043b\u0438 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435"
    },
    "granted_by_email": {
      "type": "string",
      "description": "\u041a\u0442\u043e \u0432\u044b\u0434\u0430\u043b \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "scope"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}