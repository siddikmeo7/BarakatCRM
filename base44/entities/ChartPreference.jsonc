{
  "name": "ChartPreference",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "page": {
      "type": "string",
      "enum": [
        "analytics",
        "products",
        "sales",
        "warehouses",
        "customers",
        "debts"
      ],
      "description": "\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430"
    },
    "chart_type": {
      "type": "string",
      "enum": [
        "line",
        "bar",
        "area",
        "pie",
        "donut"
      ],
      "default": "line",
      "description": "\u0422\u0438\u043f \u0433\u0440\u0430\u0444\u0438\u043a\u0430"
    },
    "metric": {
      "type": "string",
      "description": "\u041e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u043c\u0430\u044f \u043c\u0435\u0442\u0440\u0438\u043a\u0430"
    },
    "time_period": {
      "type": "number",
      "default": 7,
      "description": "\u041f\u0435\u0440\u0438\u043e\u0434 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432 \u0434\u043d\u044f\u0445"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "\u0412\u0438\u0434\u0435\u043d \u043b\u0438 \u0433\u0440\u0430\u0444\u0438\u043a"
    }
  },
  "required": [
    "business_id",
    "page"
  ]
}