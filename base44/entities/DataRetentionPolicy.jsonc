{
  "name": "DataRetentionPolicy",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430"
    },
    "business_name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0431\u0438\u0437\u043d\u0435\u0441\u0430 (\u043a\u043e\u043f\u0438\u044f \u0434\u043b\u044f \u0441\u043f\u0438\u0441\u043a\u0430)"
    },
    "retention_months": {
      "type": "number",
      "default": 0,
      "description": "\u0421\u0440\u043e\u043a \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0434\u0430\u043d\u043d\u044b\u0445 \u0432 \u043c\u0435\u0441\u044f\u0446\u0430\u0445 \u043f\u043e\u0441\u043b\u0435 \u0438\u0441\u0442\u0435\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438. 0 \u2014 \u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0431\u0435\u0441\u0441\u0440\u043e\u0447\u043d\u043e"
    },
    "note": {
      "type": "string",
      "description": "\u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439: \u0447\u0435\u043c \u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0441\u0440\u043e\u043a \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f"
    },
    "updated_by_email": {
      "type": "string",
      "description": "\u041a\u0442\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0443"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "business_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "data.is_platform_admin": true
      }
    },
    "update": {
      "user_condition": {
        "data.is_platform_admin": true
      }
    },
    "delete": {
      "user_condition": {
        "data.is_platform_admin": true
      }
    }
  }
}