{
  "name": "AlifPayment",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "order_id": {
      "type": "string",
      "description": "\u041d\u0430\u0448 \u043d\u043e\u043c\u0435\u0440 \u0437\u0430\u044f\u0432\u043a\u0438 \u043d\u0430 \u043e\u043f\u043b\u0430\u0442\u0443"
    },
    "alif_order_id": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 \u0437\u0430\u043a\u0430\u0437\u0430 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 Alif"
    },
    "transaction_id": {
      "type": "string",
      "description": "ID \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 \u0432 Alif"
    },
    "subscription_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u043e\u0448\u043b\u043e \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0435\u0441\u043b\u0438 \u044d\u0442\u043e \u0430\u0432\u0442\u043e\u043f\u0440\u043e\u0434\u043b\u0435\u043d\u0438\u0435)"
    },
    "amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430"
    },
    "currency": {
      "type": "string",
      "default": "TJS"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ok",
        "failed",
        "canceled",
        "duplicate"
      ],
      "default": "pending",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043f\u043b\u0430\u0442\u0435\u0436\u0430: pending \u2014 \u0436\u0434\u0451\u043c \u043e\u043f\u043b\u0430\u0442\u0443, ok \u2014 \u043e\u043f\u043b\u0430\u0447\u0435\u043d, failed \u2014 \u043d\u0435 \u043f\u0440\u043e\u0448\u0451\u043b, canceled \u2014 \u043e\u0442\u043c\u0435\u043d\u0451\u043d \u0441 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u043e\u043c"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "subscription",
        "one_time"
      ],
      "default": "subscription",
      "description": "\u0410\u0432\u0442\u043e\u043f\u0440\u043e\u0434\u043b\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0440\u0430\u0437\u043e\u0432\u044b\u0439 \u043f\u043b\u0430\u0442\u0451\u0436 \u0437\u0430 \u043c\u0435\u0441\u044f\u0446"
    },
    "period_key": {
      "type": "string",
      "description": "\u041f\u0435\u0440\u0438\u043e\u0434, \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043f\u043b\u0430\u0447\u0435\u043d\u043e (YYYY-MM)"
    },
    "period_days": {
      "type": "number",
      "default": 30,
      "description": "\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0434\u0430\u0451\u0442 \u044d\u0442\u043e\u0442 \u043f\u043b\u0430\u0442\u0451\u0436"
    },
    "account_masked": {
      "type": "string",
      "description": "\u041a\u0430\u0440\u0442\u0430 \u0438\u043b\u0438 \u043a\u043e\u0448\u0435\u043b\u0451\u043a, \u0441 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u0430\u043b\u0438 (\u0437\u0430\u043c\u0430\u0441\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043e)"
    },
    "transaction_type": {
      "type": "string",
      "description": "\u0421\u043f\u043e\u0441\u043e\u0431 \u043e\u043f\u043b\u0430\u0442\u044b \u0432 Alif: korti_milli, wallet \u0438 \u0442.\u0434."
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0439 \u043e\u043f\u043b\u0430\u0442\u044b"
    },
    "note": {
      "type": "string",
      "description": "\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "business_id",
    "order_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}