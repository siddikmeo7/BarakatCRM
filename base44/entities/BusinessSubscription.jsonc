{
  "name": "BusinessSubscription",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "provider": {
      "type": "string",
      "enum": [
        "base44",
        "alif",
        "manual"
      ],
      "default": "base44",
      "description": "\u041a\u0442\u043e \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043e\u043f\u043b\u0430\u0442\u0443: alif \u2014 Alif Bank \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e, base44 \u2014 Base44 Payments, manual \u2014 \u043e\u043f\u043b\u0430\u0442\u0430 \u0432\u043d\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "exempt",
        "expired",
        "blocked"
      ],
      "default": "trial",
      "description": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "auto_renew": {
      "type": "boolean",
      "default": false,
      "description": "\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u043b\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u043e\u0434\u043b\u0435\u043d\u0438\u0435 (\u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\u0435 \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435)"
    },
    "paid_until": {
      "type": "string",
      "format": "date-time",
      "description": "\u041e\u043f\u043b\u0430\u0447\u0435\u043d\u043e \u0434\u043e \u044d\u0442\u043e\u0439 \u0434\u0430\u0442\u044b \u2014 \u0434\u043e\u0441\u0442\u0443\u043f \u043e\u0442\u043a\u0440\u044b\u0442 \u0434\u043e \u043d\u0435\u0451"
    },
    "last_payment_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0439 \u043e\u043f\u043b\u0430\u0442\u044b"
    },
    "plan_price": {
      "type": "number",
      "description": "\u0421\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438 \u0432 \u043c\u0435\u0441\u044f\u0446"
    },
    "currency": {
      "type": "string",
      "default": "TJS",
      "description": "\u0412\u0430\u043b\u044e\u0442\u0430 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438"
    },
    "note": {
      "type": "string",
      "description": "\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435: \u0441\u043f\u043e\u0441\u043e\u0431 \u043e\u043f\u043b\u0430\u0442\u044b \u0438\u043b\u0438 \u043a\u0442\u043e \u0432\u044b\u0434\u0430\u043b \u0434\u043e\u0441\u0442\u0443\u043f"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "business_id",
    "provider"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}