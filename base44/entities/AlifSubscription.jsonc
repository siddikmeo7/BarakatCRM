{
  "name": "AlifSubscription",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "status": {
      "type": "string",
      "enum": [
        "none",
        "tokenization_pending",
        "tokenized",
        "accepted",
        "approved",
        "failed",
        "canceled",
        "completed"
      ],
      "default": "none",
      "description": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438 \u0432 Alif Bank: tokenization_pending \u2014 \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0430 \u043a\u0430\u0440\u0442\u044b, accepted \u2014 \u0436\u0434\u0451\u043c \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435, approved \u2014 \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0438\u0434\u0443\u0442, failed \u2014 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c, canceled \u2014 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u043e"
    },
    "token_request_id": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 \u043d\u0430\u0448\u0435\u0439 \u0437\u0430\u044f\u0432\u043a\u0438 \u043d\u0430 \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0443 \u043a\u0430\u0440\u0442\u044b (tokenization order id)"
    },
    "payment_token": {
      "type": "string",
      "description": "\u0422\u043e\u043a\u0435\u043d \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u0442\u0451\u0436\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438\u0437 Alif. \u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0435: \u043a\u043b\u0438\u0435\u043d\u0442\u0430\u043c \u043d\u0435 \u0432\u044b\u0434\u0430\u044e\u0442\u0441\u044f"
    },
    "subscription_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438 (\u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f) \u0432 Alif Bank"
    },
    "amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f"
    },
    "currency": {
      "type": "string",
      "default": "TJS"
    },
    "period": {
      "type": "string",
      "default": "monthly",
      "description": "\u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f"
    },
    "account_masked": {
      "type": "string",
      "description": "\u0417\u0430\u043c\u0430\u0441\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 \u043a\u0430\u0440\u0442\u044b \u0438\u043b\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430"
    },
    "auto_renew": {
      "type": "boolean",
      "default": true,
      "description": "\u0414\u043e\u043b\u0436\u043d\u043e \u043b\u0438 \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u043c\u0435\u0441\u044f\u0446"
    },
    "next_charge_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f"
    },
    "last_charge_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f"
    },
    "last_error": {
      "type": "string",
      "description": "\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u043f\u0440\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u0438\u043b\u0438 \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0438"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "business_id",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}