{
  "name": "Employee",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "user_email": {
      "type": "string",
      "description": "Email \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "full_name": {
      "type": "string",
      "description": "\u041f\u043e\u043b\u043d\u043e\u0435 \u0438\u043c\u044f \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "role_id": {
      "type": "string",
      "description": "ID \u0440\u043e\u043b\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d 1"
    },
    "phone2": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d 2"
    },
    "whatsapp": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 WhatsApp"
    },
    "telegram": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440/username Telegram"
    },
    "age": {
      "type": "number",
      "description": "\u0412\u043e\u0437\u0440\u0430\u0441\u0442 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "address": {
      "type": "string",
      "description": "\u0410\u0434\u0440\u0435\u0441 \u043f\u0440\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL \u0430\u0432\u0430\u0442\u0430\u0440\u0430 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "profile_sticker": {
      "type": "string",
      "description": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0442\u0438\u043a\u0435\u0440\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u044f (\u044d\u043c\u043e\u0434\u0437\u0438), \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u0432\u043e \u0432\u0441\u0435\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u0445"
    },
    "profile_frame": {
      "type": "string",
      "description": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0440\u0430\u043c\u043a\u0438 \u0430\u0432\u0430\u0442\u0430\u0440\u0430 (\u0434\u043e 5 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432), \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u0432\u043e \u0432\u0441\u0435\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u0445"
    },
    "password": {
      "type": "string",
      "description": "\u041f\u0430\u0440\u043e\u043b\u044c \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0430"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0410\u043a\u0442\u0438\u0432\u0435\u043d \u043b\u0438"
    },
    "is_frozen": {
      "type": "boolean",
      "default": false,
      "description": "\u0417\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d \u043b\u0438 \u0430\u043a\u043a\u0430\u0443\u043d\u0442 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044f \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 \u0438\u0437 \u043a\u043e\u043c\u0430\u043d\u0434\u044b. \u0415\u0441\u043b\u0438 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043e \u2014 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u0443\u0434\u0430\u043b\u0451\u043d, \u043d\u043e \u0437\u0430\u043f\u0438\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0441 \u043a\u0440\u0430\u0441\u043d\u043e\u0439 \u043f\u043e\u043c\u0435\u0442\u043a\u043e\u0439."
    },
    "is_admin": {
      "type": "boolean",
      "default": false,
      "description": "\u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440 \u2014 \u043f\u043e\u043b\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043a\u0430\u043a \u0443 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430"
    },
    "salary_per_box": {
      "type": "number",
      "default": 0,
      "description": "\u0421\u0442\u0430\u0432\u043a\u0430 \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u044b \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 \u0437\u0430 \u043e\u0434\u043d\u0443 \u043f\u0440\u043e\u0434\u0430\u043d\u043d\u0443\u044e \u043a\u043e\u0440\u043e\u0431\u043a\u0443 (\u043c\u0435\u0442\u043e\u0434 per_box)"
    },
    "salary_method": {
      "type": "string",
      "enum": [
        "per_box",
        "per_pair",
        "fixed_monthly",
        "percent_revenue"
      ],
      "default": "per_box",
      "description": "\u041c\u0435\u0442\u043e\u0434 \u0440\u0430\u0441\u0447\u0451\u0442\u0430 \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u044b: per_box (\u0437\u0430 \u043a\u043e\u0440\u043e\u0431\u043a\u0443), per_pair (\u0437\u0430 \u043f\u0430\u0440\u0443), fixed_monthly (\u0444\u0438\u043a\u0441. \u043c\u0435\u0441\u044f\u0447\u043d\u0430\u044f), percent_revenue (% \u043e\u0442 \u0432\u044b\u0440\u0443\u0447\u043a\u0438)"
    },
    "salary_rate": {
      "type": "number",
      "default": 0,
      "description": "\u0421\u0442\u0430\u0432\u043a\u0430/\u0441\u0443\u043c\u043c\u0430/\u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u0434\u043b\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0430 \u0440\u0430\u0441\u0447\u0451\u0442\u0430 \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u044b (per_pair \u2014 \u0437\u0430 \u043f\u0430\u0440\u0443, fixed_monthly \u2014 \u0441\u0443\u043c\u043c\u0430 \u0432 \u043c\u0435\u0441\u044f\u0446, percent_revenue \u2014 \u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u0432\u044b\u0440\u0443\u0447\u043a\u0438)"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0432\u0445\u043e\u0434\u0430"
    },
    "login_session_token": {
      "type": "string",
      "description": "\u0422\u043e\u043a\u0435\u043d \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u0441\u0435\u0441\u0441\u0438\u0438 \u0432\u0445\u043e\u0434\u0430 (\u0434\u043b\u044f \u0441\u0431\u0440\u043e\u0441\u0430 \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043a\u043e\u0434\u0430)"
    },
    "device_info": {
      "type": "string",
      "description": "\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e\u0431 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0435 \u043f\u0440\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c \u0432\u0445\u043e\u0434\u0435 (\u0431\u0440\u0430\u0443\u0437\u0435\u0440, \u041e\u0421)"
    },
    "permissions": {
      "type": "object",
      "description": "\u041f\u0435\u0440\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f (\u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u0440\u043e\u043b\u044c)",
      "properties": {
        "view_dashboard": {
          "type": "boolean"
        },
        "view_analytics": {
          "type": "boolean"
        },
        "view_profit": {
          "type": "boolean"
        },
        "view_stock_value": {
          "type": "boolean"
        },
        "view_purchase_price": {
          "type": "boolean"
        },
        "view_revenue": {
          "type": "boolean"
        },
        "view_employee_analytics": {
          "type": "boolean"
        },
        "view_products": {
          "type": "boolean"
        },
        "add_products": {
          "type": "boolean"
        },
        "edit_products": {
          "type": "boolean"
        },
        "delete_products": {
          "type": "boolean"
        },
        "move_products": {
          "type": "boolean"
        },
        "view_products_cost": {
          "type": "boolean"
        },
        "edit_product_purchase_price": {
          "type": "boolean"
        },
        "edit_product_sale_price": {
          "type": "boolean"
        },
        "view_sales": {
          "type": "boolean"
        },
        "view_own_sales_only": {
          "type": "boolean"
        },
        "add_sales": {
          "type": "boolean"
        },
        "edit_sales": {
          "type": "boolean"
        },
        "cancel_sales": {
          "type": "boolean"
        },
        "cancel_any_sale": {
          "type": "boolean"
        },
        "manage_discounts": {
          "type": "boolean"
        },
        "edit_sale_price": {
          "type": "boolean"
        },
        "view_sale_profit": {
          "type": "boolean"
        },
        "view_sale_purchase_price": {
          "type": "boolean"
        },
        "view_sale_customer": {
          "type": "boolean"
        },
        "view_warehouses": {
          "type": "boolean"
        },
        "manage_warehouses": {
          "type": "boolean"
        },
        "view_warehouse_value": {
          "type": "boolean"
        },
        "view_warehouse_revenue": {
          "type": "boolean"
        },
        "view_warehouse_cost": {
          "type": "boolean"
        },
        "view_warehouse_quantities": {
          "type": "boolean"
        },
        "view_customers": {
          "type": "boolean"
        },
        "manage_customers": {
          "type": "boolean"
        },
        "delete_customers": {
          "type": "boolean"
        },
        "view_customer_debt": {
          "type": "boolean"
        },
        "view_customer_contacts": {
          "type": "boolean"
        },
        "view_debts": {
          "type": "boolean"
        },
        "manage_debts": {
          "type": "boolean"
        },
        "add_debt_manual": {
          "type": "boolean"
        },
        "send_debt_reminders": {
          "type": "boolean"
        },
        "view_expenses": {
          "type": "boolean"
        },
        "view_all_expenses": {
          "type": "boolean"
        },
        "manage_expenses": {
          "type": "boolean"
        },
        "record_expenses_on_behalf": {
          "type": "boolean"
        },
        "view_expense_sales_revenue": {
          "type": "boolean"
        },
        "view_expense_money_in_hand": {
          "type": "boolean"
        },
        "manage_returns": {
          "type": "boolean"
        },
        "view_returns": {
          "type": "boolean"
        },
        "view_reports": {
          "type": "boolean"
        },
        "view_reports_detailed": {
          "type": "boolean"
        },
        "view_activity_log": {
          "type": "boolean"
        },
        "export_reports": {
          "type": "boolean"
        },
        "export_excel": {
          "type": "boolean"
        },
        "delete_activity_log": {
          "type": "boolean"
        },
        "restore_activity_log": {
          "type": "boolean"
        },
        "view_ai_assistant": {
          "type": "boolean"
        },
        "manage_telegram": {
          "type": "boolean"
        },
        "send_notifications": {
          "type": "boolean"
        },
        "manage_employees": {
          "type": "boolean"
        },
        "manage_roles": {
          "type": "boolean"
        },
        "manage_settings": {
          "type": "boolean"
        },
        "view_settings": {
          "type": "boolean"
        },
        "view_settings_language": {
          "type": "boolean"
        },
        "view_settings_defaults": {
          "type": "boolean"
        },
        "manage_settings_defaults": {
          "type": "boolean"
        },
        "view_settings_custom": {
          "type": "boolean"
        },
        "manage_settings_custom": {
          "type": "boolean"
        },
        "view_settings_security": {
          "type": "boolean"
        },
        "view_settings_codes": {
          "type": "boolean"
        },
        "backup_data": {
          "type": "boolean"
        },
        "delete_all_data": {
          "type": "boolean"
        },
        "view_salary": {
          "type": "boolean"
        },
        "manage_salary": {
          "type": "boolean"
        }
      }
    },
    "change_history": {
      "type": "array",
      "description": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "by_email": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "oldValue": {},
                "newValue": {},
                "added": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "removed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "business_id",
    "user_email",
    "name",
    "role_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}