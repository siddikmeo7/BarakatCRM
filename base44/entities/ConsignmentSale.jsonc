{
  "name": "ConsignmentSale",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "product_id": {
      "type": "string",
      "description": "ID \u0442\u043e\u0432\u0430\u0440\u0430 \u043d\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438"
    },
    "seller_email": {
      "type": "string",
      "description": "Email \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "seller_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "owner_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0442\u043e\u0432\u0430\u0440\u0430"
    },
    "owner_email": {
      "type": "string",
      "description": "Email \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430"
    },
    "brand": {
      "type": "string",
      "description": "\u0411\u0440\u0435\u043d\u0434 (snapshot)"
    },
    "model": {
      "type": "string",
      "description": "\u041c\u043e\u0434\u0435\u043b\u044c (snapshot)"
    },
    "boxes_sold": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0434\u0430\u043d\u043e \u043a\u043e\u0440\u043e\u0431\u043e\u043a"
    },
    "pairs_sold": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0434\u0430\u043d\u043e \u043f\u0430\u0440"
    },
    "items_sold": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0434\u0430\u043d\u043e \u0448\u0442\u0443\u043a"
    },
    "owner_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0437\u0430 \u043a\u043e\u0440\u043e\u0431\u043a\u0443 (snapshot)"
    },
    "sale_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0437\u0430 \u043a\u043e\u0440\u043e\u0431\u043a\u0443 (snapshot)"
    },
    "total_amount": {
      "type": "number",
      "description": "\u041e\u0431\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u043f\u0440\u043e\u0434\u0430\u0436\u0438"
    },
    "seller_profit": {
      "type": "number",
      "description": "\u041f\u0440\u0438\u0431\u044b\u043b\u044c \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430 = (sale_price - owner_price) * boxes"
    },
    "owner_amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430, \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0449\u0430\u044f \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0443 = owner_price * boxes"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u0440\u043e\u0434\u0430\u0436\u0438"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "is_cancelled": {
      "type": "boolean",
      "default": false,
      "description": "\u041e\u0442\u043c\u0435\u043d\u0435\u043d\u0430 \u043b\u0438 \u043f\u0440\u043e\u0434\u0430\u0436\u0430"
    }
  },
  "required": [
    "business_id",
    "product_id",
    "boxes_sold",
    "total_amount"
  ]
}