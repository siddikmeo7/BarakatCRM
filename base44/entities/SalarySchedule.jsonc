{
  "name": "SalarySchedule",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "employee_id": {
      "type": "string",
      "description": "ID \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "pay_day": {
      "type": "number",
      "default": 1,
      "description": "\u0414\u0435\u043d\u044c \u043c\u0435\u0441\u044f\u0446\u0430, \u043a\u043e\u0433\u0434\u0430 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u0443 (1-31). \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0435\u0439\u0441\u044f \u0432\u044b\u043f\u043b\u0430\u0442\u044b \u043a\u0430\u0436\u0434\u044b\u0439 \u043c\u0435\u0441\u044f\u0446"
    },
    "pay_time": {
      "type": "string",
      "default": "10:00",
      "description": "\u0412\u0440\u0435\u043c\u044f \u0432\u044b\u043f\u043b\u0430\u0442\u044b \u0432 \u0444\u043e\u0440\u043c\u0430\u0442\u0435 \u0427\u0427:\u041c\u041c"
    },
    "next_pay_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0422\u043e\u0447\u043d\u0430\u044f \u0434\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u0432\u044b\u043f\u043b\u0430\u0442\u044b (\u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u0430\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u0430). \u0415\u0441\u043b\u0438 \u0437\u0430\u0434\u0430\u043d\u0430 \u2014 \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0434\u0435\u043d\u044c \u043c\u0435\u0441\u044f\u0446\u0430"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "business_id",
    "employee_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    }
  }
}