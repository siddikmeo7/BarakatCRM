{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete"
      ],
      "description": "\u0422\u0438\u043f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f"
    },
    "entity_type": {
      "type": "string",
      "description": "\u0422\u0438\u043f \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438 (Product, Sale, Customer \u0438 \u0442.\u0434.)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438"
    },
    "entity_data": {
      "type": "object",
      "description": "\u0414\u0430\u043d\u043d\u044b\u0435 \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u043c\u043e\u043c\u0435\u043d\u0442 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044f"
    },
    "user_email": {
      "type": "string",
      "description": "Email \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f"
    },
    "is_restored": {
      "type": "boolean",
      "default": false,
      "description": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u043b\u0438"
    }
  },
  "required": [
    "business_id",
    "action_type",
    "entity_type",
    "user_email"
  ]
}