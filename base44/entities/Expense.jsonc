{
  "name": "Expense",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u0410\u0440\u0435\u043d\u0434\u0430",
        "\u0417\u0430\u0440\u043f\u043b\u0430\u0442\u0430",
        "\u0422\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442",
        "\u041a\u043e\u043c\u043c\u0443\u043d\u0430\u043b\u044c\u043d\u044b\u0435",
        "\u0420\u0435\u043a\u043b\u0430\u043c\u0430",
        "\u0415\u0434\u0430",
        "\u041f\u0440\u043e\u0447\u0435\u0435"
      ],
      "description": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0440\u0430\u0441\u0445\u043e\u0434\u0430"
    },
    "amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430 \u0440\u0430\u0441\u0445\u043e\u0434\u0430"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 / \u043f\u0440\u0438\u0447\u0438\u043d\u0430 \u0440\u0430\u0441\u0445\u043e\u0434\u0430"
    },
    "recipient": {
      "type": "string",
      "description": "\u041a\u043e\u043c\u0443 \u0432\u044b\u043f\u043b\u0430\u0447\u0435\u043d\u043e"
    },
    "expense_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0440\u0430\u0441\u0445\u043e\u0434\u0430"
    },
    "created_by_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0430\u0432\u0442\u043e\u0440\u0430 \u0440\u0430\u0441\u0445\u043e\u0434\u0430 (\u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a/\u0432\u043b\u0430\u0434\u0435\u043b\u0435\u0446)"
    },
    "created_by_role": {
      "type": "string",
      "enum": [
        "owner",
        "employee",
        "admin"
      ],
      "description": "\u0420\u043e\u043b\u044c \u0430\u0432\u0442\u043e\u0440\u0430 \u0440\u0430\u0441\u0445\u043e\u0434\u0430"
    },
    "edit_count": {
      "type": "number",
      "default": 0,
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0439 (\u043c\u0430\u043a\u0441. 5)"
    },
    "edit_history": {
      "type": "array",
      "description": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0440\u0430\u0441\u0445\u043e\u0434\u0430",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "edited_at": {
            "type": "string"
          },
          "by_email": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "oldValue": {},
                "newValue": {}
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "business_id",
    "category",
    "amount",
    "expense_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}