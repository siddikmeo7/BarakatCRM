{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "owner_email": {
      "type": "string",
      "description": "Email \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430"
    },
    "phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d 1"
    },
    "phone2": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d 2"
    },
    "address": {
      "type": "string",
      "description": "\u0410\u0434\u0440\u0435\u0441"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0410\u043a\u0442\u0438\u0432\u0435\u043d \u043b\u0438 \u0431\u0438\u0437\u043d\u0435\u0441"
    },
    "business_code": {
      "type": "string",
      "description": "\u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 12-\u0437\u043d\u0430\u0447\u043d\u044b\u0439 \u043a\u043e\u0434 \u0431\u0438\u0437\u043d\u0435\u0441\u0430 \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0430"
    },
    "access_code": {
      "type": "string",
      "description": "\u041a\u043e\u0434 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0434\u043b\u044f \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432"
    },
    "default_color": {
      "type": "string",
      "default": "\u0427\u0451\u0440\u043d\u044b\u0439",
      "description": "\u0426\u0432\u0435\u0442 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"
    },
    "default_size_from": {
      "type": "number",
      "default": 39,
      "description": "\u0420\u0430\u0437\u043c\u0435\u0440 \u043e\u0442"
    },
    "default_size_to": {
      "type": "number",
      "default": 44,
      "description": "\u0420\u0430\u0437\u043c\u0435\u0440 \u0434\u043e"
    },
    "default_pairs_per_box": {
      "type": "number",
      "default": 6,
      "description": "\u041f\u0430\u0440 \u0432 \u043a\u043e\u0440\u043e\u0431\u043a\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"
    },
    "default_product_type": {
      "type": "string",
      "default": "\u0422\u0443\u0444\u043b\u0438",
      "description": "\u0422\u0438\u043f \u0442\u043e\u0432\u0430\u0440\u0430 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"
    },
    "default_consignment_owner": {
      "type": "string",
      "description": "\u0412\u043b\u0430\u0434\u0435\u043b\u0435\u0446 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u043d\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438"
    },
    "default_consignment_owner_email": {
      "type": "string",
      "description": "Email \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u043d\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438"
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "tj",
        "en"
      ],
      "default": "ru",
      "description": "\u042f\u0437\u044b\u043a \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430"
    },
    "custom_colors": {
      "type": "array",
      "description": "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u0446\u0432\u0435\u0442\u0430",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "custom_product_types": {
      "type": "array",
      "description": "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u0442\u0438\u043f\u044b \u0442\u043e\u0432\u0430\u0440\u0430",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "custom_pairs_per_box": {
      "type": "array",
      "description": "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u043f\u0430\u0440 \u0432 \u043a\u043e\u0440\u043e\u0431\u043a\u0435",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "low_stock_limit": {
      "type": "number",
      "default": 2,
      "description": "\u041b\u0438\u043c\u0438\u0442 \u043a\u043e\u0440\u043e\u0431\u043e\u043a \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u043e \u043c\u0430\u043b\u043e\u043c \u0437\u0430\u043f\u0430\u0441\u0435"
    },
    "low_stock_digest_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "never"
      ],
      "default": "monthly",
      "description": "\u0427\u0430\u0441\u0442\u043e\u0442\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u0441\u0432\u043e\u0434\u043a\u0438 \u00ab\u043c\u0430\u043b\u043e \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u0435\u00bb"
    },
    "low_stock_digest_last_sent": {
      "type": "string",
      "format": "date-time",
      "description": "\u041a\u043e\u0433\u0434\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0440\u0430\u0437 \u0431\u044b\u043b\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u0441\u0432\u043e\u0434\u043a\u0430 \u043f\u043e \u043c\u0430\u043b\u043e\u043c\u0443 \u043e\u0441\u0442\u0430\u0442\u043a\u0443"
    },
    "telegram_chat_id": {
      "type": "string",
      "description": "Telegram Chat ID (\u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439, \u0434\u043b\u044f \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0439 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438)"
    },
    "telegram_recipients": {
      "type": "array",
      "description": "\u0421\u043f\u0438\u0441\u043e\u043a \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u0435\u0439 Telegram \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "chat_id": {
            "type": "string"
          }
        }
      }
    },
    "whatsapp_recipients": {
      "type": "array",
      "description": "\u0421\u043f\u0438\u0441\u043e\u043a \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u0435\u0439 WhatsApp \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      }
    },
    "default_notify_channels": {
      "type": "array",
      "description": "\u041a\u0430\u043d\u0430\u043b\u044b \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439 \u043a\u043b\u0438\u0435\u043d\u0442\u0443 \u043e \u043f\u043e\u043a\u0443\u043f\u043a\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e (whatsapp, telegram, email)",
      "default": [
        "whatsapp"
      ],
      "items": {
        "type": "string",
        "enum": [
          "whatsapp",
          "telegram",
          "email"
        ]
      }
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "exempt",
        "expired",
        "blocked"
      ],
      "default": "trial",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0431\u0438\u0437\u043d\u0435\u0441\u0430: trial \u2014 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u043c\u0435\u0441\u044f\u0446, active \u2014 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0430 \u043e\u043f\u043b\u0430\u0447\u0435\u043d\u0430, exempt \u2014 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043f\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u044b, expired \u2014 \u0441\u0440\u043e\u043a \u0438\u0441\u0442\u0451\u043a, blocked \u2014 \u0434\u043e\u0441\u0442\u0443\u043f \u0437\u0430\u043a\u0440\u044b\u0442"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u041a\u043e\u0433\u0434\u0430 \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u043c\u0435\u0441\u044f\u0446. \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u043e \u2014 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f 30 \u0434\u043d\u0435\u0439 \u043e\u0442 \u0434\u0430\u0442\u044b \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "subscription_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u041a\u043e\u0433\u0434\u0430 \u0431\u044b\u043b\u0430 \u043e\u043f\u043b\u0430\u0447\u0435\u043d\u0430 (\u0438\u043b\u0438 \u0432\u044b\u0434\u0430\u043d\u0430) \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0430"
    },
    "subscription_note": {
      "type": "string",
      "description": "\u0417\u0430\u043c\u0435\u0442\u043a\u0430 \u043e \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0435: \u0441\u043f\u043e\u0441\u043e\u0431 \u043e\u043f\u043b\u0430\u0442\u044b \u0438\u043b\u0438 \u043a\u0442\u043e \u0432\u044b\u0434\u0430\u043b \u0434\u043e\u0441\u0442\u0443\u043f"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    }
  }
}