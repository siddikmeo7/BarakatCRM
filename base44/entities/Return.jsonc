{
  "name": "Return",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "customer_id": {
      "type": "string",
      "description": "ID \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "product_id": {
      "type": "string",
      "description": "ID \u0442\u043e\u0432\u0430\u0440\u0430"
    },
    "warehouse_id": {
      "type": "string",
      "description": "ID \u0441\u043a\u043b\u0430\u0434\u0430 \u043a\u0443\u0434\u0430 \u0432\u0435\u0440\u043d\u0443\u043b\u0438 \u0442\u043e\u0432\u0430\u0440"
    },
    "sale_id": {
      "type": "string",
      "description": "ID \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0440\u043e\u0434\u0430\u0436\u0438"
    },
    "boxes_returned": {
      "type": "number",
      "description": "\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u043e \u043a\u043e\u0440\u043e\u0431\u043e\u043a"
    },
    "condition": {
      "type": "string",
      "enum": [
        "\u041d\u043e\u0432\u044b\u0439",
        "\u0425\u043e\u0440\u043e\u0448\u0435\u0435",
        "\u0421\u0440\u0435\u0434\u043d\u0435\u0435",
        "\u041f\u043b\u043e\u0445\u043e\u0435"
      ],
      "default": "\u0425\u043e\u0440\u043e\u0448\u0435\u0435",
      "description": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0442\u043e\u0432\u0430\u0440\u0430"
    },
    "refund_amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430"
    },
    "reason": {
      "type": "string",
      "description": "\u041f\u0440\u0438\u0447\u0438\u043d\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430"
    },
    "return_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "business_id",
    "product_id",
    "warehouse_id",
    "boxes_returned",
    "refund_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    }
  }
}