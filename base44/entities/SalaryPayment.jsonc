{
  "name": "SalaryPayment",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "employee_id": {
      "type": "string",
      "description": "ID \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "employee_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "employee_email": {
      "type": "string",
      "description": "Email \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430"
    },
    "amount": {
      "type": "number",
      "description": "\u0412\u044b\u043f\u043b\u0430\u0447\u0435\u043d\u043d\u0430\u044f \u0441\u0443\u043c\u043c\u0430"
    },
    "method": {
      "type": "string",
      "enum": [
        "per_box",
        "per_pair",
        "fixed_monthly",
        "percent_revenue"
      ],
      "default": "per_box",
      "description": "\u041c\u0435\u0442\u043e\u0434 \u0440\u0430\u0441\u0447\u0451\u0442\u0430, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0441\u0434\u0435\u043b\u0430\u043d\u0430 \u0432\u044b\u043f\u043b\u0430\u0442\u0430"
    },
    "period_key": {
      "type": "string",
      "description": "\u041a\u043b\u044e\u0447 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0432\u044b\u043f\u043b\u0430\u0442\u044b (YYYY-MM)"
    },
    "period_label": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u00ab\u041e\u043a\u0442\u044f\u0431\u0440\u044c 2026\u00bb)"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0432\u044b\u043f\u043b\u0430\u0442\u044b \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u044b"
    },
    "paid_by_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0442\u043e\u0433\u043e, \u043a\u0442\u043e \u0432\u044b\u043f\u043b\u0430\u0442\u0438\u043b \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u0443"
    },
    "paid_by_email": {
      "type": "string",
      "description": "Email \u0442\u043e\u0433\u043e, \u043a\u0442\u043e \u0432\u044b\u043f\u043b\u0430\u0442\u0438\u043b \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u0443"
    },
    "note": {
      "type": "string",
      "description": "\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435 \u043a \u0432\u044b\u043f\u043b\u0430\u0442\u0435"
    },
    "corrections": {
      "type": "array",
      "description": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0441\u0443\u043c\u043c\u044b \u0432\u044b\u043f\u043b\u0430\u0442\u044b (\u0435\u0441\u043b\u0438 \u043f\u0440\u0438 \u0432\u0432\u043e\u0434\u0435 \u0431\u044b\u043b\u043e \u0443\u043a\u0430\u0437\u0430\u043d\u043e \u043d\u0435\u0432\u0435\u0440\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e)",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "corrected_at": {
            "type": "string"
          },
          "by_email": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "old_amount": {
            "type": "number"
          },
          "new_amount": {
            "type": "number"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u0434\u043e 1000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"
    }
  },
  "required": [
    "business_id",
    "employee_id",
    "amount",
    "period_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "data.is_platform_admin": true
          }
        }
      ]
    }
  }
}