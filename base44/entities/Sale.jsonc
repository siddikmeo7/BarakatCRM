{
  "name": "Sale",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID \u0431\u0438\u0437\u043d\u0435\u0441\u0430"
    },
    "product_id": {
      "type": "string",
      "description": "ID \u0442\u043e\u0432\u0430\u0440\u0430"
    },
    "warehouse_id": {
      "type": "string",
      "description": "ID \u0441\u043a\u043b\u0430\u0434\u0430"
    },
    "boxes_sold": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0434\u0430\u043d\u043e \u043a\u043e\u0440\u043e\u0431\u043e\u043a"
    },
    "pairs_sold": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0434\u0430\u043d\u043e \u043f\u0430\u0440 (\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438)"
    },
    "items_sold": {
      "type": "number",
      "description": "\u041f\u0440\u043e\u0434\u0430\u043d\u043e \u0448\u0442\u0443\u043a (\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438)"
    },
    "sale_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u043f\u0440\u043e\u0434\u0430\u0436\u0438"
    },
    "purchase_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0437\u0430\u043a\u0443\u043f\u043a\u0438"
    },
    "total_amount": {
      "type": "number",
      "description": "\u041e\u0431\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430"
    },
    "profit": {
      "type": "number",
      "description": "\u041f\u0440\u0438\u0431\u044b\u043b\u044c"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u0440\u043e\u0434\u0430\u0436\u0438"
    },
    "is_debt": {
      "type": "boolean",
      "default": false,
      "description": "\u041f\u0440\u043e\u0434\u0430\u0436\u0430 \u0432 \u0434\u043e\u043b\u0433"
    },
    "customer_id": {
      "type": "string",
      "description": "ID \u043a\u043b\u0438\u0435\u043d\u0442\u0430 (\u0435\u0441\u043b\u0438 \u0432 \u0434\u043e\u043b\u0433)"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043a\u043b\u0438\u0435\u043d\u0442\u0430 (\u0434\u043b\u044f \u043d\u0430\u043b\u0438\u0447\u043d\u044b\u0445)"
    },
    "customer_address": {
      "type": "string",
      "description": "\u0410\u0434\u0440\u0435\u0441 \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "partial_payment": {
      "type": "number",
      "default": 0,
      "description": "\u0427\u0430\u0441\u0442\u0438\u0447\u043d\u0430\u044f \u043e\u043f\u043b\u0430\u0442\u0430 \u043f\u0440\u0438 \u043f\u0440\u043e\u0434\u0430\u0436\u0435 \u0432 \u0434\u043e\u043b\u0433"
    },
    "payment_due_date": {
      "type": "string",
      "format": "date",
      "description": "\u0421\u0440\u043e\u043a \u043e\u043f\u043b\u0430\u0442\u044b \u0434\u043e\u043b\u0433\u0430 (\u0434\u0430\u0442\u0430)"
    },
    "seller_email": {
      "type": "string",
      "description": "Email \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "seller_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430"
    },
    "is_cancelled": {
      "type": "boolean",
      "default": false,
      "description": "\u041e\u0442\u043c\u0435\u043d\u0435\u043d\u0430 \u043b\u0438 \u043f\u0440\u043e\u0434\u0430\u0436\u0430"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u043e\u0442\u043c\u0435\u043d\u044b"
    },
    "edit_count": {
      "type": "number",
      "default": 0,
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0439 (\u043c\u0430\u043a\u0441. 5)"
    },
    "edit_history": {
      "type": "array",
      "description": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0439",
      "items": {
        "type": "object",
        "properties": {
          "edited_at": {
            "type": "string"
          },
          "boxes_sold": {
            "type": "number"
          },
          "sale_price": {
            "type": "number"
          },
          "total_amount": {
            "type": "number"
          },
          "profit": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "business_id",
    "product_id",
    "boxes_sold",
    "total_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}