{
  "name": "\u0415\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0430\u044f \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f \u0432 Google Drive",
  "description": "\u041a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0432 03:00 \u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 Asia/Shanghai \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u043f\u043e\u043b\u043d\u0443\u044e \u043a\u043e\u043f\u0438\u044e \u0434\u0430\u043d\u043d\u044b\u0445 \u0432\u0441\u0435\u0445 \u0431\u0438\u0437\u043d\u0435\u0441\u043e\u0432 (\u0442\u043e\u0432\u0430\u0440\u044b, \u0441\u043a\u043b\u0430\u0434\u044b, \u043f\u0440\u043e\u0434\u0430\u0436\u0438, \u043a\u043b\u0438\u0435\u043d\u0442\u044b, \u0434\u043e\u043b\u0433\u0438, \u0440\u0430\u0441\u0445\u043e\u0434\u044b, \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0438, \u0437\u0430\u0440\u043f\u043b\u0430\u0442\u044b) \u0432 Google Drive \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c JSON-\u0444\u0430\u0439\u043b\u043e\u043c.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Asia/Shanghai",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_drive_backup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_drive_backup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyDriveBackup",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "\u041a\u043e\u043f\u0438\u044f \u0432 Google Drive",
            "description": "\u0412\u0441\u0435 \u0431\u0438\u0437\u043d\u0435\u0441\u044b, \u043f\u043e\u043b\u043d\u044b\u0439 \u043d\u0430\u0431\u043e\u0440 \u0434\u0430\u043d\u043d\u044b\u0445"
          }
        }
      }
    ]
  }
}